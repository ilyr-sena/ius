; ======================================================================
; meridian-relay — WinUSB driver binding for Apple iOS devices
; ======================================================================
;
; PURPOSE
;   Binds Microsoft's inbox WinUSB driver to Apple mobile devices so
;   libusb (used by meridian-relay) can open their mux interfaces.
;
; MATCHING STRATEGY
;   Composite-interface class match on the Apple multiplexor interface:
;     Class    = FF    (vendor specific)
;     SubClass = FE    (254)
;     Protocol = 02    (mux protocol)
;   This matches the mux interface of every iPhone/iPad mode (initial,
;   Valeria, CDC-NCM) across all product IDs — no per-model list to
;   maintain.
;
; DEPLOYMENT NOTES
;   - While bound to WinUSB, iTunes will not see the device. Remove the
;     binding (pnputil /delete-driver oem<N>.inf /uninstall, or reassign
;     via Device Manager) to restore iTunes.
;   - Sign the catalog (.cat) for production/enterprise deployment.
;     Unsigned packages are rejected when Secure Boot is enabled unless
;     the machine permits test-signed drivers.
;   - meridian-relay can install this automatically:
;       meridian-relay.exe setup
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = USBDevice
ClassGUID   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %ManufacturerName%
CatalogFile = meridian-relay-winusb.cat
DriverVer   = 01/01/2026,0.3.0.0
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Interfaces,NTamd64

[Interfaces.NTamd64]
; Composite-interface compatible ID for the Apple mux interface.
%DeviceDesc% = WinUsb_Install, USB\Class_FF&SubClass_FE&Prot_02

; ----------------------------------------------------------------------
; Generic WinUSB installation (per Microsoft docs)
; ----------------------------------------------------------------------
[WinUsb_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[WinUsb_Install.Services]
Include    = winusb.inf
AddService = WinUSB, 0x00000002, WinUsb_ServiceInstall

[WinUsb_ServiceInstall]
DisplayName   = %WinUSB_SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WinUSB.sys

[WinUsb_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{90197CFE-798F-4b3b-9B18-2DEAA6B19A1C}"

[Strings]
ManufacturerName = "Meridian Relay Project"
DeviceDesc       = "Apple Mobile Device (WinUSB mux interface for meridian-relay)"
WinUSB_SvcDesc   = "WinUSB Driver"
