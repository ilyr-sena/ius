; ======================================================================
; meridian-relay — WinUSB driver binding for Apple iOS devices
; ======================================================================
;
; Binds Microsoft's inbox WinUSB driver to the Apple mobile-device USB
; interface so libusb (used by meridian-relay) can open bulk pipes.
;
; IMPORTANT DEPLOYMENT NOTES
; --------------------------
; 1. Only ONE function driver can own the interface at a time. While a
;    device is bound to WinUSB, iTunes/Apple Mobile Device Service will
;    not see it. Install this INF only on devices you intend to use with
;    meridian-relay.
; 2. Test-sign this INF/CAT in CI before enterprise deployment. Unsigned
;    INFs require "test mode" or are rejected on Secure Boot machines.
; 3. Install:  pnputil /add-driver .\meridian-relay-winusb.inf /install
;    Remove:    pnputil /delete-driver oem<N>.inf /uninstall
;
; Device VID/PIDs below cover Apple mobile devices from iPhone 5s through
; iPhone 16 (interface class FF/FE/01 - vendor specific, mux interface).

[Version]
Signature   = "$WINDOWS NT$"
Class       = USBDevice
ClassGUID   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %ManufacturerName%
CatalogFile = meridian-relay-winusb.cat
DriverVer   = 01/01/2026,0.3.0.0
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = AppleDevices,NTamd64

[AppleDevices.NTamd64]
%DeviceDesc% = WinUsb_Install, USB\VID_05AC&PID_12A8  ; iPhone 5s era
%DeviceDesc% = WinUsb_Install, USB\VID_05AC&PID_12B0  ; iPhone 6
%DeviceDesc% = WinUsb_Install, USB\VID_05AC&PID_12C0  ; iPhone 7
%DeviceDesc% = WinUsb_Install, USB\VID_05AC&PID_12C8  ; iPhone 8/X
%DeviceDesc% = WinUsb_Install, USB\VID_05AC&PID_12D0  ; iPhone XR/XS
%DeviceDesc% = WinUsb_Install, USB\VID_05AC&PID_12D8  ; iPhone 11
%DeviceDesc% = WinUsb_Install, USB\VID_05AC&PID_12E0  ; iPhone 12 / SE2
%DeviceDesc% = WinUsb_Install, USB\VID_05AC&PID_12E8  ; iPhone 13
%DeviceDesc% = WinUsb_Install, USB\VID_05AC&PID_12F0  ; iPhone 14
%DeviceDesc% = WinUsb_Install, USB\VID_05AC&PID_12F8  ; iPhone 15
%DeviceDesc% = WinUsb_Install, USB\VID_05AC&PID_1300  ; iPhone 16
%DeviceDesc% = WinUsb_Install, USB\VID_05AC&PID_1310  ; iPad
%DeviceDesc% = WinUsb_Install, USB\VID_05AC&PID_1318  ; iPad Pro
%DeviceDesc% = WinUsb_Install, USB\VID_05AC&PID_1400  ; iPod touch 7

; ----------------------------------------------------------------------
; Generic WinUSB installation (per Microsoft docs)
; ----------------------------------------------------------------------
[WinUsb_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[WinUsb_Install.Services]
Include    = winusb.inf
AddService = WinUSB, 0x00000002, WinUsb_ServiceInstall

[WinUsb_ServiceInstall]
DisplayName   = %WinUSB_SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WinUSB.sys

[WinUsb_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{90197CFE-798F-4b3b-9B18-2DEAA6B19A1C}"

[Strings]
ManufacturerName = "Meridian Relay Project"
DeviceDesc       = "Apple Mobile Device (WinUSB for meridian-relay)"
WinUSB_SvcDesc   = "WinUSB Driver"
